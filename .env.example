# Supabase backend — SAME project as the mobile app (INVGEN-APP).
# Copy to .env.local and fill in. Never commit .env.local.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# GST verification — prefer the Edge Function proxy (recommended):
#   supabase secrets set APPYFLOW_KEY=<key_secret>
#   supabase functions deploy verify-gst
# .../supabase/functions/verify-gst/index.ts in this repo.
# Optional dev fallback (exposes the key in the browser bundle):
# VITE_APPYFLOW_KEY=key_secret_value
