# Supabase backend — SAME project as the mobile app (INVGEN-APP).
# Copy to .env.local and fill in. Never commit .env.local.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# GST verification — Edge Function proxy (key stays server-side, never in bundle):
#   supabase secrets set APPYFLOW_KEY=<rotated_key_secret>
#   supabase functions deploy verify-gst
# Source: supabase/functions/verify-gst/index.ts
# For local dev ONLY (exposes key in browser bundle — never set in Vercel Production):
#   VITE_APPYFLOW_KEY=<dev_key_secret>
# Production MUST NOT set VITE_APPYFLOW_KEY — build will fail if present.
# Rotate the exposed key in AppyFlow dashboard before deploying.
